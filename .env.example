# Copy to .env and fill in. Placeholder values only: never commit real ones.

# Postgres. Tables are created by `vexoulz-auth db upgrade`, which runs before the service starts.
AUTH_DATABASE_URL=postgresql://vexoulz_auth:change-me@db:5432/vexoulz_auth

# Where browsers reach this service. The Twitch application's OAuth redirect URL must be
# <AUTH_PUBLIC_URL>/callback, exactly.
AUTH_PUBLIC_URL=https://auth.example.net

# The Twitch application (dev.twitch.tv/console).
AUTH_TWITCH_CLIENT_ID=your-twitch-client-id
AUTH_TWITCH_CLIENT_SECRET=your-twitch-client-secret

# Encrypts the stored Twitch tokens. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes every stored token unreadable: people sign in again.
AUTH_TOKEN_KEY=

# The sites, comma separated: the only pages that may read /v1/* and the only places /login returns to.
AUTH_SITE_ORIGINS=https://example.net,https://vods.example.net

# Backends that sign people in through this service. JSON, inline or in a file (a mounted secret; the
# file wins). scopes may only name user:read:moderated_channels.
AUTH_CLIENTS=[{"id":"dtp","secret":"long-random-secret","redirect_uris":["https://bot.example.net/auth/admin/callback"],"scopes":["user:read:moderated_channels"]}]
# AUTH_CLIENTS_FILE=/run/secrets/auth-clients.json

# AUTH_SESSION_DAYS=30
# Only for local development over plain http:
# AUTH_COOKIE_SECURE=false
# AUTH_PORT=8090
# Reverse proxies whose X-Forwarded-For is believed (for rate limits and the audit log).
# AUTH_FORWARDED_ALLOW_IPS=127.0.0.1
